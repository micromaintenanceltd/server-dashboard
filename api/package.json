{
  "name": "mml-server-dashboard-api",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker API for the MML server monitoring dashboard.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute mml_dashboard --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute mml_dashboard --remote --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute mml_dashboard --local --file=./seed.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260721.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.0.0"
  }
}
